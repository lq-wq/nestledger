# 复制为 .env 后按需修改：cp .env.example .env
#
# ⚠️ 只有【源码构建版】docker-compose.build.yml 会读本文件。
#    默认主文件 docker-compose.yml 自 v1.2.0 起是自包含版（零文件依赖），
#    不读 .env —— 端口 / 口令 / 备份份数请直接改 YAML 里的 ports 与 environment。
#    纯镜像版 docker-compose.image.yml 同样不读 .env。

# 宿主机访问端口（容器内部固定 8787）
PORT=8787

# 时区（影响快照文件名和界面日期）
TZ=Asia/Shanghai

# 每次写入自动保留的历史快照份数
BACKUP_KEEP=30

# 是否每次写入自动生成快照：1 开启 / 0 关闭
BACKUP_ON_WRITE=1

# 单次请求体积上限（字节），默认 64 MB，合同附件越大可适当调高
MAX_BODY=67108864

# 可选：需要外网 / 多人访问时开启简单口令，浏览器会弹出登录框
# 两个都填写才会生效
AUTH_USER=
AUTH_PASS=

# 可选：源码构建时的基础镜像。默认 node:22-alpine。
# 若 NAS 报 Get "https://registry-1.docker.io/v2/": context deadline exceeded，
# 优先在「飞牛 Docker → 设置 → 镜像加速」配置加速器；不行再改这里，
# 填 NAS 实际能拉到的 node:22-alpine 完整地址，例如：
# BASE_IMAGE=你的加速地址/library/node:22-alpine
BASE_IMAGE=node:22-alpine

# 说明：IMAGE 变量只用于 docker-compose.image.yml（纯 GHCR 镜像模式）。
# 默认主文件 docker-compose.yml 与源码构建版 docker-compose.build.yml 都不使用它。

# ------------------------------------------------------------
# 网页端自动更新（v1.3.0 起）—— 仅【默认自包含版】docker-compose.yml 使用
# ------------------------------------------------------------
# 该版本不读 .env，下面这些只是配置参考，请直接改 YAML 的 environment：
#   UPDATE_REPO=lq-wq/nestledger        更新来源仓库
#   UPDATE_BRANCH=main                   更新来源分支
#   UPDATE_AUTO=1                        发现新版自动应用；改 0 则只提示不自动装
#   UPDATE_AUTO_RESTART=1                服务端代码变化后自动重启容器；改 0 需手动重启
#   UPDATE_INTERVAL=21600                检查间隔（秒），默认 6 小时
#   UPDATE_TIMEOUT=8000                  单个更新源超时（毫秒）
#   UPDATE_OFF=1                         彻底关闭联网检查（镜像版 / 源码构建版已默认设置）
#   UPDATE_MANIFEST_URL=...              国内访问 GitHub 不稳定时，填可达的更新清单镜像地址
#   UPDATE_MANIFEST_URLS=...             多个源（逗号分隔）；v1.3.2 起自动取其中最高版本
#   UPDATE_ONLY_CUSTOM=1                  只使用自定义源，不回退到 GitHub
#
# v1.3.2 起服务端并发请求全部更新源并采用最高版本；jsDelivr 对 GitHub 分支文件有
# 12 小时~7 天的 CDN 缓存，单靠 no-cache 请求头绕不过，多源比对才是根本解法。
# 若卡在 v1.3.0 / v1.3.1 提示「已是最新版本」，把 UPDATE_MANIFEST_URL 指向
# https://github.com/lq-wq/nestledger/releases/download/latest/latest.json 并重启即可升上来。
#
# 更新包是仓库里的 update/latest.json（含 sha256），服务端校验后写入 data/app 覆盖层，
# 更新前自动生成数据快照；网页「关于与更新」里可手动检查、立即更新、恢复内置版本。
# 镜像版请用「拉取 / 更新」或 docker-compose.autoupdate.yml 的 Watchtower；
# 源码构建版请用 git pull && docker compose -f docker-compose.build.yml up -d --build。
