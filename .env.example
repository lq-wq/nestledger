# 复制为 .env 后按需修改：cp .env.example .env
# 说明：compose 会自动读取同目录下的 .env

# 宿主机访问端口（容器内部固定 8787）
PORT=8787

# 时区（影响快照文件名和界面日期）
TZ=Asia/Shanghai

# 每次写入自动保留的历史快照份数
BACKUP_KEEP=30

# 是否每次写入自动生成快照：1 开启 / 0 关闭
BACKUP_ON_WRITE=1

# 单次请求体积上限（字节），默认 64 MB，合同附件越大可适当调高
MAX_BODY=67108864

# 可选：需要外网 / 多人访问时开启简单口令，浏览器会弹出登录框
# 两个都填写才会生效
AUTH_USER=
AUTH_PASS=

# 可选：改用 GitHub Actions 推送到 GHCR 的镜像，便于一条命令更新
# 去掉注释并换成自己的 GitHub 用户名；之后执行 docker compose pull && docker compose up -d
# IMAGE=ghcr.io/yourname/nestledger:latest
